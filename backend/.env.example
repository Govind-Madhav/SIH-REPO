# Copy this file to .env and fill in real values.
# The platform runs in full DEMO/SIMULATION mode with no keys at all --
# every integration below degrades gracefully (logs instead of calling out)
# when its key is missing, so you can demo the whole app with zero setup.

# --- OpenWeatherMap (https://openweathermap.org/api) ---
# Used to pull live rainfall/temperature/humidity per district instead of
# the built-in weather simulator.
OPENWEATHERMAP_API_KEY=

# --- Twilio (https://www.twilio.com/try-twilio) ---
# Used for real WhatsApp + SMS delivery of SOS alerts and route-danger
# notifications. Create a free trial account, enable the WhatsApp Sandbox,
# and get a trial SMS-capable phone number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM_NUMBER=
TWILIO_WHATSAPP_FROM_NUMBER=whatsapp:+14155238886

# --- App config ---
DATABASE_URL=sqlite:///./logisense.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
